// JOBHUNT OS — Prisma schema
//
// Phase 1 (Candidate Intelligence) tables only. Later phases add their own
// tables through reviewed migrations. Design authority: docs/database-schema.md.
//
// Conventions:
//   - Primary keys: UUIDv7 generated by the app (src/lib/ids.ts / uuid(7))
//   - snake_case tables/columns via @@map / @map; timestamps are timestamptz
//   - Every user-owned row carries user_id (tenant boundary, RLS predicate)
//   - Row Level Security + grants are defined in the migration SQL
//     (see prisma/migrations/*_phase1_candidate/migration.sql, "RLS" section)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum VerificationStatus {
  VERIFIED
  USER_PROVIDED
  NEEDS_REVIEW
  AI_INFERRED

  @@map("verification_status")
}

enum FactSourceType {
  MANUAL_ENTRY
  CV_IMPORT
  DOCUMENT_IMPORT
  PORTFOLIO_IMPORT
  USER_APPROVED_AI_EXTRACTION
  SYSTEM
  OTHER

  @@map("fact_source_type")
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED

  @@map("document_status")
}

enum FactCandidateStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("fact_candidate_status")
}

enum ExtractionMethod {
  RULE
  AI

  @@map("extraction_method")
}

enum WorkAuthorizationStatus {
  AUTHORIZED
  NOT_AUTHORIZED
  SPONSORSHIP_REQUIRED
  UNKNOWN
  NEEDS_REVIEW

  @@map("work_authorization_status")
}

// ---------------------------------------------------------------------------
// Identity (Better Auth). Field names follow Better Auth's model contract.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  accounts            Account[]
  candidateProfile    CandidateProfile?
  education           CandidateEducation[]
  experiences         CandidateExperience[]
  achievements        CandidateAchievement[]
  skills              CandidateSkill[]
  projects            CandidateProject[]
  certifications      CandidateCertification[]
  portfolioItems      CandidatePortfolioItem[]
  languages           CandidateLanguage[]
  workAuthorizations  CandidateWorkAuthorization[]
  preferences         CandidatePreferences?
  targetLocations     CandidateTargetLocation[]
  documents           CandidateDocument[]
  factCandidates      CandidateFactCandidate[]
  aiGenerations       AiGeneration[]
  auditLogs           AuditLog[]
  jobSources          JobSource[]
  createdJobs         Job[]
  jobMatches          JobMatch[]
  marketLocations     MarketLocation[]
  jobCategories       JobCategory[]
  jobCategoryTerms    JobCategoryTerm[]
  searchProfiles      SearchProfile[]
  searchProfileHits   JobSearchProfileHit[]
  categoryAssignments JobCategoryAssignment[]
  discoveryRuns       DiscoveryRun[]
  sourceSyncRuns      SourceSyncRun[]
  jobMatchDimensions  JobMatchDimension[]
  jobStates           UserJobState[]
  savedSearches       SavedSearch[]

  @@map("users")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash for the app's own email/password login only (never third-party passwords).
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// Reference data (global catalog)
// ---------------------------------------------------------------------------

model Country {
  code           String  @id @db.Char(2)
  name           String
  isTargetMarket Boolean @default(false) @map("is_target_market")
  isEnabled      Boolean @default(true) @map("is_enabled")

  profiles           CandidateProfile[]
  workAuthorizations CandidateWorkAuthorization[]
  targetLocations    CandidateTargetLocation[]
  jobs               Job[]
  marketLocations    MarketLocation[]

  @@map("countries")
}

// ---------------------------------------------------------------------------
// Candidate profile (1:1 with user)
// ---------------------------------------------------------------------------

model CandidateProfile {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @unique @map("user_id") @db.Uuid
  fullName              String?            @map("full_name")
  headline              String?
  currentCity           String?            @map("current_city")
  currentCountryCode    String?            @map("current_country_code") @db.Char(2)
  /// AES-256-GCM ciphertext (src/server/crypto.ts)
  phoneEnc              String?            @map("phone_enc")
  /// AES-256-GCM ciphertext (src/server/crypto.ts)
  professionalEmailEnc  String?            @map("professional_email_enc")
  websiteUrl            String?            @map("website_url")
  linkedinUrl           String?            @map("linkedin_url")
  githubUrl             String?            @map("github_url")
  portfolioUrl          String?            @map("portfolio_url")
  summary               String?
  careerGoal            String?            @map("career_goal")
  availability          String?
  availableFrom         DateTime?          @map("available_from") @db.Date
  noticePeriodWeeks     Int?               @map("notice_period_weeks")
  yearsOfExperience     Float?             @map("years_of_experience")
  /// DRAFT until onboarding is finished; ACTIVE afterwards.
  profileStatus         String             @default("DRAFT") @map("profile_status")
  onboardingState       Json               @default("{}") @map("onboarding_state")
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at") @db.Timestamptz(3)
  sourceType            FactSourceType     @default(MANUAL_ENTRY) @map("source_type")
  verificationStatus    VerificationStatus @default(USER_PROVIDED) @map("verification_status")
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCountry Country?   @relation(fields: [currentCountryCode], references: [code])
  jobMatches     JobMatch[]

  @@map("candidate_profiles")
}

// ---------------------------------------------------------------------------
// Candidate facts. Every table shares the provenance column group:
//   verification_status, source_type, source_document_id, source_fact_candidate_id,
//   source_excerpt, confidence, verified_at, created_at, updated_at, deleted_at
// ---------------------------------------------------------------------------

model CandidateEducation {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  institution           String
  degree                String?
  fieldOfStudy          String?            @map("field_of_study")
  location              String?
  startDate             String?            @map("start_date") @db.VarChar(7)
  endDate               String?            @map("end_date") @db.VarChar(7)
  isCurrent             Boolean            @default(false) @map("is_current")
  description           String?
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument CandidateDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@map("candidate_education")
}

model CandidateExperience {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  organization          String
  title                 String
  employmentType        String?            @map("employment_type")
  location              String?
  startDate             String?            @map("start_date") @db.VarChar(7)
  endDate               String?            @map("end_date") @db.VarChar(7)
  isCurrent             Boolean            @default(false) @map("is_current")
  description           String?
  responsibilities      String[]           @default([])
  skillsUsed            String[]           @default([]) @map("skills_used")
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument CandidateDocument?     @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  achievements   CandidateAchievement[]

  @@index([userId, deletedAt])
  @@map("candidate_experiences")
}

model CandidateProject {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  name                  String
  description           String?
  role                  String?
  projectType           String?            @map("project_type")
  technologies          String[]           @default([])
  skills                String[]           @default([])
  responsibilities      String[]           @default([])
  outcomes              String[]           @default([])
  portfolioUrl          String?            @map("portfolio_url")
  repositoryUrl         String?            @map("repository_url")
  liveUrl               String?            @map("live_url")
  imageUrls             String[]           @default([]) @map("image_urls")
  startDate             String?            @map("start_date") @db.VarChar(7)
  endDate               String?            @map("end_date") @db.VarChar(7)
  isCurrent             Boolean            @default(false) @map("is_current")
  teamSize              Int?               @map("team_size")
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument CandidateDocument?       @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  achievements   CandidateAchievement[]
  portfolioItems CandidatePortfolioItem[]

  @@index([userId, deletedAt])
  @@map("candidate_projects")
}

/// Citable atoms. Linked to an experience or a project (or standalone). Never invented.
model CandidateAchievement {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  experienceId          String?            @map("experience_id") @db.Uuid
  projectId             String?            @map("project_id") @db.Uuid
  statement             String
  /// Only set when the user supplies a real figure. Never generated.
  metric                String?
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience     CandidateExperience? @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  project        CandidateProject?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument CandidateDocument?   @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@map("candidate_achievements")
}

model CandidateSkill {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  name                  String
  nameNormalized        String             @map("name_normalized")
  category              String
  /// 1–5, user-set only. Never inferred without user approval.
  proficiency           Int?
  yearsUsed             Float?             @map("years_used")
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument CandidateDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  // Partial unique index (user_id, name_normalized) WHERE deleted_at IS NULL is added in SQL.
  @@index([userId, deletedAt])
  @@map("candidate_skills")
}

model CandidateCertification {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  name                  String
  issuer                String?
  issueDate             String?            @map("issue_date") @db.VarChar(7)
  expiryDate            String?            @map("expiry_date") @db.VarChar(7)
  credentialId          String?            @map("credential_id")
  credentialUrl         String?            @map("credential_url")
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument CandidateDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@map("candidate_certifications")
}

model CandidatePortfolioItem {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  title                 String
  type                  String
  url                   String?
  description           String?
  skills                String[]           @default([])
  projectId             String?            @map("project_id") @db.Uuid
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        CandidateProject?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceDocument CandidateDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@map("candidate_portfolio_items")
}

model CandidateLanguage {
  id                    String             @id @default(uuid(7)) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  language              String
  languageNormalized    String             @map("language_normalized")
  /// CEFR A1–C2 or NATIVE. User-stated; never inferred.
  proficiency           String?
  reading               String?
  writing               String?
  speaking              String?
  sortOrder             Int                @default(0) @map("sort_order")
  verificationStatus    VerificationStatus @map("verification_status")
  sourceType            FactSourceType     @map("source_type")
  sourceDocumentId      String?            @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?            @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?            @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocument CandidateDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@map("candidate_languages")
}

/// The user's stated situation per country. Not an eligibility judgement.
model CandidateWorkAuthorization {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  userId                String                  @map("user_id") @db.Uuid
  countryCode           String                  @map("country_code") @db.Char(2)
  status                WorkAuthorizationStatus
  permitType            String?                 @map("permit_type")
  validUntil            DateTime?               @map("valid_until") @db.Date
  notes                 String?
  sortOrder             Int                     @default(0) @map("sort_order")
  verificationStatus    VerificationStatus      @map("verification_status")
  sourceType            FactSourceType          @map("source_type")
  sourceDocumentId      String?                 @map("source_document_id") @db.Uuid
  sourceFactCandidateId String?                 @map("source_fact_candidate_id") @db.Uuid
  sourceExcerpt         String?                 @map("source_excerpt")
  confidence            Float?
  verifiedAt            DateTime?               @map("verified_at") @db.Timestamptz(3)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?               @map("deleted_at") @db.Timestamptz(3)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  country        Country            @relation(fields: [countryCode], references: [code])
  sourceDocument CandidateDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, deletedAt])
  @@map("candidate_work_authorizations")
}

// ---------------------------------------------------------------------------
// Preferences (user settings — changeable any time, no verification needed)
// ---------------------------------------------------------------------------

model CandidatePreferences {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  targetRoles      String[] @default([]) @map("target_roles")
  targetIndustries String[] @default([]) @map("target_industries")
  employmentTypes  String[] @default([]) @map("employment_types")
  seniorityLevels  String[] @default([]) @map("seniority_levels")
  workModes        String[] @default([]) @map("work_modes")
  companySizes     String[] @default([]) @map("company_sizes")
  companyTypes     String[] @default([]) @map("company_types")
  relocation       String?
  needsSponsorship String?  @map("needs_sponsorship")
  salaryMin        Int?     @map("salary_min")
  salaryMax        Int?     @map("salary_max")
  salaryCurrency   String?  @map("salary_currency") @db.Char(3)
  salaryPeriod     String?  @map("salary_period")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_preferences")
}

model CandidateTargetLocation {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  countryCode String   @map("country_code") @db.Char(2)
  city        String?
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country @relation(fields: [countryCode], references: [code])

  @@index([userId])
  @@map("candidate_target_locations")
}

// ---------------------------------------------------------------------------
// Documents & extraction
// ---------------------------------------------------------------------------

model CandidateDocument {
  id                  String         @id @default(uuid(7)) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  candidateId         String         @map("candidate_id") @db.Uuid
  fileName            String         @map("file_name")
  fileType            String         @map("file_type")
  sizeBytes           Int            @map("size_bytes")
  sha256              String         @db.Char(64)
  storagePath         String         @unique @map("storage_path")
  documentType        String         @map("document_type")
  status              DocumentStatus @default(UPLOADED)
  /// Extracted plain text. Personal data: never logged, never sent off-server except to the configured local AI.
  extractedText       String?        @map("extracted_text")
  errorCode           String?        @map("error_code")
  errorMessage        String?        @map("error_message")
  aiStatus            String?        @map("ai_status")
  uploadedAt          DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  processingStartedAt DateTime?      @map("processing_started_at") @db.Timestamptz(3)
  processedAt         DateTime?      @map("processed_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  factCandidates     CandidateFactCandidate[]
  education          CandidateEducation[]
  experiences        CandidateExperience[]
  achievements       CandidateAchievement[]
  skills             CandidateSkill[]
  projects           CandidateProject[]
  certifications     CandidateCertification[]
  portfolioItems     CandidatePortfolioItem[]
  languages          CandidateLanguage[]
  workAuthorizations CandidateWorkAuthorization[]

  @@index([userId, uploadedAt(sort: Desc)])
  @@index([userId, sha256])
  @@map("candidate_documents")
}

/// Staging area: possible facts found in a document, awaiting user review.
model CandidateFactCandidate {
  id             String              @id @default(uuid(7)) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  documentId     String              @map("document_id") @db.Uuid
  category       String
  payload        Json
  excerpt        String?
  confidence     Float
  method         ExtractionMethod
  /// Always NEEDS_REVIEW (rule/AI extraction) or AI_INFERRED (AI suggestion). Never VERIFIED.
  proposedStatus VerificationStatus  @map("proposed_status")
  status         FactCandidateStatus @default(PENDING)
  duplicateOf    Json?               @map("duplicate_of")
  resultKind     String?             @map("result_kind")
  resultId       String?             @map("result_id") @db.Uuid
  aiGenerationId String?             @map("ai_generation_id") @db.Uuid
  reviewedAt     DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  document     CandidateDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  aiGeneration AiGeneration?     @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([documentId])
  @@map("candidate_fact_candidates")
}

// ---------------------------------------------------------------------------
// AI & audit
// ---------------------------------------------------------------------------

model AiGeneration {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  agent         String
  task          String
  provider      String
  model         String
  promptVersion Int      @map("prompt_version")
  inputHash     String   @map("input_hash") @db.Char(64)
  /// Validated structured output only; raw prompts/inputs are never stored.
  output        Json?
  status        String
  errorCode     String?  @map("error_code")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int      @map("latency_ms")
  traceId       String?  @map("trace_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  factCandidates CandidateFactCandidate[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("ai_generations")
}

/// Append-only. The app role may only INSERT/SELECT (see migration grants).
model AuditLog {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  actorType    String   @map("actor_type")
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  /// Field names changed + non-sensitive metadata. Never raw personal values.
  metadata     Json     @default("{}")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Job discovery: source configuration (user-owned)
// Closed value sets are enforced with CHECK constraints in the migration SQL.
// ---------------------------------------------------------------------------

model JobSource {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// ASHBY | LEVER | GREENHOUSE | MANUAL
  sourceKey         String    @map("source_key")
  sourceName        String    @map("source_name")
  /// ATS_PUBLIC_API | MANUAL
  sourceType        String    @map("source_type")
  /// PENDING_VERIFICATION | READY | MANUAL_ONLY | ERROR — internal product state, not a legal approval
  status            String
  /// PUBLIC_POSTINGS_API | USER_ENTERED
  accessMethod      String    @map("access_method")
  /// NOT_REVIEWED | VERIFIED | RESTRICTED | NOT_APPLICABLE
  termsStatus       String    @map("terms_status")
  termsReviewedAt   DateTime? @map("terms_reviewed_at") @db.Timestamptz(3)
  enabled           Boolean   @default(false)
  /// Source-specific settings, validated by Zod (src/modules/jobs/sources.schemas.ts)
  configuration     Json      @default("{}")
  rateLimitSettings Json      @default("{}") @map("rate_limit_settings")
  notes             String?
  lastTestedAt      DateTime? @map("last_tested_at") @db.Timestamptz(3)
  lastSyncAt        DateTime? @map("last_sync_at") @db.Timestamptz(3)
  lastSuccessAt     DateTime? @map("last_success_at") @db.Timestamptz(3)
  lastError         String?   @map("last_error")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs     Job[]
  syncRuns SourceSyncRun[]

  @@unique([userId, sourceKey])
  @@map("job_sources")
}

// ---------------------------------------------------------------------------
// Phase 2 — Job catalog
//   companies: shared catalog (public entities, no owner)
//   jobs: canonical jobs. visibility PUBLIC = shared discovered job;
//         PRIVATE = user-entered job visible only to created_by_user_id.
// Closed value sets are CHECK constraints in the migration SQL.
// ---------------------------------------------------------------------------

model Company {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String
  /// Lower-cased, punctuation/legal-suffix stripped (src/lib/text-normalize.ts)
  nameNormalized String   @unique @map("name_normalized")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobs Job[]

  @@map("companies")
}

model Job {
  id                  String                   @id @default(uuid(7)) @db.Uuid
  companyId           String                   @map("company_id") @db.Uuid
  sourceId            String?                  @map("source_id") @db.Uuid
  /// MANUAL | ASHBY | LEVER | GREENHOUSE
  sourceKey           String                   @map("source_key")
  /// MANUAL | ATS_PUBLIC_API
  sourceType          String                   @map("source_type")
  /// USER_ENTERED | DISCOVERED
  sourceStatus        String                   @map("source_status")
  externalJobId       String?                  @map("external_job_id")
  title               String
  normalizedTitle     String                   @map("normalized_title")
  /// Plain text only; rendered escaped, never as HTML
  description         String
  locationRaw         String                   @map("location_raw")
  city                String?
  region              String?
  countryCode         String?                  @map("country_code") @db.Char(2)
  employmentType      String                   @default("UNKNOWN") @map("employment_type")
  employmentTypeRaw   String?                  @map("employment_type_raw")
  remoteStatus        String                   @default("UNKNOWN") @map("remote_status")
  remoteStatusRaw     String?                  @map("remote_status_raw")
  relocationAvailable String                   @default("UNKNOWN") @map("relocation_available")
  salaryMin           Int?                     @map("salary_min")
  salaryMax           Int?                     @map("salary_max")
  salaryCurrency      String?                  @map("salary_currency") @db.Char(3)
  salaryPeriod        String?                  @map("salary_period")
  salaryRaw           String?                  @map("salary_raw")
  postedAt            DateTime?                @map("posted_at") @db.Date
  discoveredAt        DateTime                 @default(now()) @map("discovered_at") @db.Timestamptz(3)
  lastSeenAt          DateTime                 @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  jobUrl              String                   @map("job_url")
  applicationUrl      String?                  @map("application_url")
  sourceUrl           String?                  @map("source_url")
  visaTextRaw         String?                  @map("visa_text_raw")
  department          String?
  team                String?
  /// INTERNSHIP | ENTRY_LEVEL | GRADUATE | JUNIOR | MID_LEVEL | SENIOR | LEAD | UNKNOWN — only from explicit wording
  experienceLevel     String                   @default("UNKNOWN") @map("experience_level")
  /// The exact wording the experience level was read from (e.g. "Intern" in the title)
  experienceLevelRaw  String?                  @map("experience_level_raw")
  /// sha256(normalized company | normalized title | location key) — layer-2 dedupe key
  dedupeFingerprint   String?                  @map("dedupe_fingerprint") @db.Char(64)
  sourceUpdatedAt     DateTime?                @map("source_updated_at") @db.Timestamptz(3)
  lastContentChangeAt DateTime?                @map("last_content_change_at") @db.Timestamptz(3)
  closedAt            DateTime?                @map("closed_at") @db.Timestamptz(3)
  /// Private notes of the creator (PRIVATE jobs only)
  notes               String?
  contentHash         String                   @map("content_hash") @db.Char(64)
  /// OPEN | CLOSED | STALE | UNKNOWN
  status              String                   @default("OPEN")
  /// PUBLIC | PRIVATE
  visibility          String
  createdByUserId     String?                  @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(3)
  /// Generated full-text vector (title, location, department, description) — read via raw SQL only
  searchVector        Unsupported("tsvector")? @map("search_vector")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  source    JobSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  country   Country?   @relation(fields: [countryCode], references: [code])
  createdBy User?      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  requirements        JobRequirement[]
  requirementSets     JobRequirementSet[]
  matches             JobMatch[]
  postings            JobSourcePosting[]
  categoryAssignments JobCategoryAssignment[]
  profileHits         JobSearchProfileHit[]
  duplicateOf         JobDuplicateCandidate[] @relation("DuplicateCandidateJob")
  duplicatedBy        JobDuplicateCandidate[] @relation("DuplicateCandidateOriginal")
  userStates          UserJobState[]

  @@index([createdByUserId, deletedAt, createdAt(sort: Desc)])
  @@index([visibility, status])
  @@index([companyId])
  @@index([sourceId])
  @@index([dedupeFingerprint])
  @@index([countryCode, remoteStatus])
  @@index([postedAt(sort: Desc)])
  @@index([discoveredAt(sort: Desc)])
  @@index([lastSeenAt(sort: Desc)])
  @@index([sourceKey])
  @@map("jobs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Discovery configuration & execution (see docs/job-discovery.md)
//   market_locations / job_categories / job_category_terms: configuration data.
//     user_id NULL = system default (read-only); user_id set = user-added.
//   search_profiles: USER-OWNED "what I want to find". Never a candidate claim.
//   job_source_postings: every source listing of a canonical job (multi-source).
//   job_category_assignments: derived classification; never overwrites the job.
//   job_search_profile_hits: which of the user's profiles found which job.
//   discovery_runs / source_sync_runs: USER-OWNED execution history.
// Closed value sets are CHECK constraints in the migration SQL.
// ---------------------------------------------------------------------------

model MarketLocation {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// NULL = system default location; otherwise added by this user
  userId      String?  @map("user_id") @db.Uuid
  countryCode String   @map("country_code") @db.Char(2)
  name        String
  /// CITY | REGION | METRO | REMOTE_COUNTRY
  kind        String
  /// Lower-cased alternative spellings used for matching (e.g. "bangalore")
  aliases     String[] @default([])
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  country  Country                 @relation(fields: [countryCode], references: [code])
  profiles SearchProfileLocation[]

  @@index([countryCode, sortOrder])
  @@index([userId])
  @@map("market_locations")
}

model JobCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// NULL = system default category; otherwise a custom category of this user
  userId      String?  @map("user_id") @db.Uuid
  /// Stable slug, e.g. "ai-automation"
  key         String
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User?                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  terms       JobCategoryTerm[]
  profiles    SearchProfileCategory[]
  assignments JobCategoryAssignment[]

  @@index([userId])
  @@map("job_categories")
}

model JobCategoryTerm {
  id         String   @id @default(uuid(7)) @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  /// NULL = system default term; otherwise added by this user
  userId     String?  @map("user_id") @db.Uuid
  /// Search term (NOT a candidate skill), e.g. "Automation Specialist"
  term       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  category JobCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([userId])
  @@map("job_category_terms")
}

model SearchProfile {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  name                  String
  enabled               Boolean   @default(true)
  /// ISO country codes; empty = any country
  countryCodes          String[]  @default([]) @map("country_codes")
  /// Extra free search terms on top of the selected categories' terms
  searchTerms           String[]  @default([]) @map("search_terms")
  /// REMOTE | HYBRID | ONSITE | UNKNOWN; empty = any
  workModes             String[]  @default([]) @map("work_modes")
  /// FULL_TIME | PART_TIME | INTERNSHIP | ... | UNKNOWN; empty = any
  employmentTypes       String[]  @default([]) @map("employment_types")
  /// INTERNSHIP | ENTRY_LEVEL | GRADUATE | ... | UNKNOWN; empty = any
  experienceLevels      String[]  @default([]) @map("experience_levels")
  salaryMin             Int?      @map("salary_min")
  salaryMax             Int?      @map("salary_max")
  salaryCurrency        String?   @map("salary_currency") @db.Char(3)
  salaryPeriod          String?   @map("salary_period")
  /// SPONSORSHIP_REQUIRED | SPONSORSHIP_PREFERRED | SPONSORSHIP_NOT_REQUIRED | UNKNOWN (informational, not a filter)
  visaPreference        String    @default("UNKNOWN") @map("visa_preference")
  /// Source keys to run; empty = every enabled source
  sourceKeys            String[]  @default([]) @map("source_keys")
  /// NULL = manual only; otherwise run automatically every N hours
  scheduleIntervalHours Int?      @map("schedule_interval_hours")
  nextRunAt             DateTime? @map("next_run_at") @db.Timestamptz(3)
  lastRunAt             DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations  SearchProfileLocation[]
  categories SearchProfileCategory[]
  hits       JobSearchProfileHit[]
  runs       DiscoveryRun[]

  @@unique([userId, name])
  @@index([enabled, nextRunAt])
  @@map("search_profiles")
}

model SearchProfileLocation {
  profileId  String @map("profile_id") @db.Uuid
  locationId String @map("location_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  profile  SearchProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  location MarketLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([profileId, locationId])
  @@index([locationId])
  @@index([userId])
  @@map("search_profile_locations")
}

model SearchProfileCategory {
  profileId  String @map("profile_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  userId     String @map("user_id") @db.Uuid

  profile  SearchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  category JobCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([profileId, categoryId])
  @@index([categoryId])
  @@index([userId])
  @@map("search_profile_categories")
}

model JobSourcePosting {
  id              String    @id @default(uuid(7)) @db.Uuid
  jobId           String    @map("job_id") @db.Uuid
  /// ASHBY | LEVER | GREENHOUSE
  sourceKey       String    @map("source_key")
  board           String
  externalJobId   String    @map("external_job_id")
  jobUrl          String    @map("job_url")
  applicationUrl  String?   @map("application_url")
  sourceUrl       String?   @map("source_url")
  /// Original source payload (long text fields removed; description lives on the job)
  raw             Json      @default("{}")
  contentHash     String    @map("content_hash") @db.Char(64)
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Set when a complete (untruncated) board fetch no longer lists this posting
  removedAt       DateTime? @map("removed_at") @db.Timestamptz(3)
  sourceUpdatedAt DateTime? @map("source_updated_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([sourceKey, board, externalJobId])
  @@index([jobId])
  @@index([sourceKey, board, removedAt])
  @@index([sourceKey, jobId])
  @@map("job_source_postings")
}

model JobDuplicateCandidate {
  id            String   @id @default(uuid(7)) @db.Uuid
  jobId         String   @map("job_id") @db.Uuid
  duplicateOfId String   @map("duplicate_of_id") @db.Uuid
  /// SAME_CONTENT | SIMILAR_TITLE_LOCATION
  reason        String
  similarity    Float
  /// PENDING | CONFIRMED | DISMISSED — uncertain duplicates are never merged silently
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  job         Job @relation("DuplicateCandidateJob", fields: [jobId], references: [id], onDelete: Cascade)
  duplicateOf Job @relation("DuplicateCandidateOriginal", fields: [duplicateOfId], references: [id], onDelete: Cascade)

  @@unique([jobId, duplicateOfId])
  @@index([duplicateOfId])
  @@index([status])
  @@map("job_duplicate_candidates")
}

model JobCategoryAssignment {
  id                String   @id @default(uuid(7)) @db.Uuid
  jobId             String   @map("job_id") @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  /// NULL = system classification (system terms); set = this user's terms/custom category or their own AI run
  userId            String?  @map("user_id") @db.Uuid
  /// RULE | AI | USER
  method            String
  confidence        Float
  /// Terms/wording that triggered the classification (explainability)
  matchedTerms      String[] @default([]) @map("matched_terms")
  /// Model/provider for AI classifications, e.g. "ollama:llama3.1:8b"
  model             String?
  classifierVersion String   @map("classifier_version")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  job      Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category JobCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([categoryId, jobId])
  @@index([userId])
  @@map("job_category_assignments")
}

model JobSearchProfileHit {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  profileId      String   @map("profile_id") @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  discoveryRunId String?  @map("discovery_run_id") @db.Uuid
  /// Which profile criteria matched and which could not be compared (explainability)
  reasons        Json     @default("{}")
  firstMatchedAt DateTime @default(now()) @map("first_matched_at") @db.Timestamptz(3)
  lastMatchedAt  DateTime @default(now()) @map("last_matched_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile SearchProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  run     DiscoveryRun? @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)

  @@unique([profileId, jobId])
  @@index([userId, jobId])
  @@index([jobId])
  @@index([discoveryRunId])
  @@map("job_search_profile_hits")
}

model DiscoveryRun {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  profileId    String?   @map("profile_id") @db.Uuid
  /// MANUAL | SCHEDULED
  trigger      String
  /// QUEUED | RUNNING | SUCCEEDED | PARTIAL | FAILED | CANCELLED
  status       String    @default("QUEUED")
  /// QUEUED | FETCHING | NORMALIZING | DEDUPLICATING | SAVING | MATCHING_PROFILE | DONE
  stage        String    @default("QUEUED")
  /// Exact search configuration used for this run (profile snapshot)
  criteria     Json      @default("{}")
  sourcesTotal Int       @default(0) @map("sources_total")
  sourcesDone  Int       @default(0) @map("sources_done")
  fetched      Int       @default(0)
  valid        Int       @default(0)
  invalid      Int       @default(0)
  created      Int       @default(0)
  updated      Int       @default(0)
  unchanged    Int       @default(0)
  duplicates   Int       @default(0)
  /// Possible duplicates flagged for review (never merged)
  flagged      Int       @default(0)
  closed       Int       @default(0)
  matched      Int       @default(0)
  errorCount   Int       @default(0) @map("error_count")
  message      String?
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(3)
  heartbeatAt  DateTime? @map("heartbeat_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile  SearchProfile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  syncRuns SourceSyncRun[]
  hits     JobSearchProfileHit[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([profileId])
  @@index([status])
  @@map("discovery_runs")
}

model SourceSyncRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  discoveryRunId String?   @map("discovery_run_id") @db.Uuid
  sourceId       String?   @map("source_id") @db.Uuid
  /// ASHBY | LEVER | GREENHOUSE
  sourceKey      String    @map("source_key")
  board          String
  /// TEST | SYNC
  kind           String    @default("SYNC")
  /// RUNNING | SUCCEEDED | FAILED | SKIPPED
  status         String    @default("RUNNING")
  requests       Int       @default(0)
  fetched        Int       @default(0)
  valid          Int       @default(0)
  invalid        Int       @default(0)
  created        Int       @default(0)
  updated        Int       @default(0)
  unchanged      Int       @default(0)
  duplicates     Int       @default(0)
  flagged        Int       @default(0)
  closed         Int       @default(0)
  truncated      Boolean   @default(false)
  errorKind      String?   @map("error_kind")
  errorMessage   String?   @map("error_message")
  /// Up to a few invalid-posting reasons (field paths only, no payloads)
  invalidReasons Json      @default("{}") @map("invalid_reasons")
  durationMs     Int?      @map("duration_ms")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  run    DiscoveryRun? @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  source JobSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt(sort: Desc)])
  @@index([discoveryRunId])
  @@index([sourceId, startedAt(sort: Desc)])
  @@map("source_sync_runs")
}

// ---------------------------------------------------------------------------
// Phase 4 — Job matching (see docs/matching.md)
//   job_requirements: structured requirements extracted from a job, always
//     traceable to the original wording (source_text + source_reference).
//     Visible to anyone who can see the job; writable by the owner of a
//     private job (shared-job requirements are written by the system).
//   job_matches / job_match_dimensions: USER-OWNED explainable results.
// Closed value sets are CHECK constraints in the migration SQL.
// ---------------------------------------------------------------------------

model JobRequirement {
  id               String   @id @default(uuid(7)) @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  setId            String   @map("set_id") @db.Uuid
  /// Order within the set (structured fields first, then description order)
  position         Int      @default(0)
  /// SKILL | EXPERIENCE | EDUCATION | LOCATION | WORK_MODE | EMPLOYMENT | SALARY | AUTHORIZATION | LANGUAGE | CERTIFICATION | DOMAIN | PORTFOLIO | OTHER
  category         String
  /// Short human-readable requirement, e.g. "React" or "2+ years marketing"
  text             String
  /// Machine-usable structure for evaluators (validated by Zod per category)
  normalizedValue  Json     @default("{}") @map("normalized_value")
  /// REQUIRED | PREFERRED | INFORMATIONAL | UNKNOWN
  requirementType  String   @map("requirement_type")
  /// Original wording from the job, verbatim
  sourceText       String   @map("source_text")
  confidence       Float
  /// Where the wording came from, e.g. "description:120-178" or "field:salary"
  sourceReference  String   @map("source_reference")
  /// RULE | AI | USER
  extractionMethod String   @map("extraction_method")
  extractorVersion String   @map("extractor_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  job Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  set JobRequirementSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([jobId, category])
  @@index([setId, position])
  @@map("job_requirements")
}

/// Phase 4: one immutable, numbered extraction of a job's requirements.
model JobRequirementSet {
  id               String   @id @default(uuid(7)) @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  version          Int
  /// e.g. "rules-1", "user", "legacy"
  extractorVersion String   @map("extractor_version")
  /// jobs.content_hash the set was extracted from (a different hash = job changed)
  jobContentHash   String   @map("job_content_hash") @db.Char(64)
  isCurrent        Boolean  @default(true) @map("is_current")
  requirementCount Int      @default(0) @map("requirement_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  job          Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  requirements JobRequirement[]

  @@unique([jobId, version])
  @@map("job_requirement_sets")
}

model JobMatch {
  id                    String   @id @default(uuid(7)) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  jobId                 String   @map("job_id") @db.Uuid
  candidateId           String   @map("candidate_id") @db.Uuid
  /// STRONG_MATCH | GOOD_MATCH | PARTIAL_MATCH | REVIEW | BLOCKED (system categories, not hiring predictions)
  overallStatus         String   @map("overall_status")
  /// Sorting aid derived from dimensions (0-100). Never the verdict.
  summaryScore          Int?     @map("summary_score")
  hardBlock             Boolean  @default(false) @map("hard_block")
  hardBlockReason       String?  @map("hard_block_reason")
  /// { fits: Statement[], gaps: Statement[], unknowns: Statement[] }; every statement cites evidence
  explanation           Json     @default("{}")
  matchingVersion       String   @map("matching_version")
  /// CURRENT | STALE | REQUIRES_RECALCULATION
  freshness             String   @default("CURRENT")
  candidateSnapshotHash String   @map("candidate_snapshot_hash") @db.Char(64)
  jobContentHash        String   @map("job_content_hash") @db.Char(64)
  computedAt            DateTime @map("computed_at") @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job        Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate  CandidateProfile    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  dimensions JobMatchDimension[]

  @@unique([userId, jobId])
  @@index([userId, overallStatus])
  @@index([jobId])
  @@index([candidateId])
  @@map("job_matches")
}

model JobMatchDimension {
  id        String   @id @default(uuid(7)) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// SKILLS | EXPERIENCE | EDUCATION | PROJECTS | PORTFOLIO | LOCATION | WORK_MODE | EMPLOYMENT_TYPE | SALARY | WORK_AUTHORIZATION | LANGUAGE | CAREER_PREFERENCES
  dimension String
  /// STRONG_MATCH | MATCH | PARTIAL_MATCH | UNKNOWN | GAP | BLOCKED | NOT_APPLICABLE
  status    String
  /// True when the result is driven by an explicit hard requirement
  isHard    Boolean  @default(false) @map("is_hard")
  summary   String
  /// Array of evidence items (requirementId, factRef, verification, reasoning, outcome); validated by Zod
  evidence  Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  match JobMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, dimension])
  @@index([userId])
  @@map("job_match_dimensions")
}

/// Phase 3: the user's own state for a shared job (bookmark / hide). Never changes the job.
model UserJobState {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  jobId        String    @map("job_id") @db.Uuid
  bookmarkedAt DateTime? @map("bookmarked_at") @db.Timestamptz(3)
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@map("user_job_states")
}

/// Phase 3: a saved /jobs query + filter state (distinct from a Search Profile).
model SavedSearch {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String
  /// Validated JobSearchParams (src/modules/jobs/search/params.ts)
  params    Json      @default("{}")
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("saved_searches")
}
