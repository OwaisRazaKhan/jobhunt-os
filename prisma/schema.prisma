// ---------------------------------------------------------------------------
// Phase 6 — Resume Studio (see docs/resume-studio.md)
//   A resume is a PRESENTATION of candidate facts, never a source of truth.
//   resumes: user-owned containers (one master per user, tailored ones link a job).
//   resume_versions: the structured ResumeDocument (validated JSON) + SHA-256 content
//     hash. APPROVED versions are immutable (DB trigger); edits create new versions.
//   resume_fact_references: which candidate fact supports which resume item.
//   resume_checks / findings: deterministic Resume Check results for a content hash.
//   resume_approvals: exact-content approvals (hash); revoked, never deleted.
//   resume_exports: generated PDF/DOCX files in private storage.
// Closed value sets are CHECK constraints in the migration SQL.
// ---------------------------------------------------------------------------

model Resume {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  name             String
  description      String?
  /// MASTER | TAILORED | GENERAL
  kind             String
  /// ACTIVE | ARCHIVED
  status           String    @default("ACTIVE")
  /// CLASSIC | MODERN | TECHNICAL | EDITORIAL (code-defined templates)
  template         String    @default("CLASSIC")
  /// A4 | LETTER
  pageFormat       String    @default("A4") @map("page_format")
  /// Resume this one was duplicated or tailored from
  sourceResumeId   String?   @map("source_resume_id") @db.Uuid
  /// Target job for tailored resumes
  targetJobId      String?   @map("target_job_id") @db.Uuid
  /// Latest version (working head)
  currentVersionId String?   @unique @map("current_version_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceResume   Resume?         @relation("ResumeSource", fields: [sourceResumeId], references: [id], onDelete: SetNull)
  derived        Resume[]        @relation("ResumeSource")
  targetJob      Job?            @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  currentVersion ResumeVersion?  @relation("ResumeCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       ResumeVersion[] @relation("ResumeVersions")

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([sourceResumeId])
  @@index([targetJobId])
  @@map("resumes")
}

model ResumeVersion {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  resumeId        String   @map("resume_id") @db.Uuid
  versionNumber   Int      @map("version_number")
  parentVersionId String?  @map("parent_version_id") @db.Uuid
  /// MASTER | TAILORED | MANUAL_EDIT | RESTORED | DUPLICATE
  versionType     String   @map("version_type")
  /// DRAFT | READY_FOR_REVIEW | APPROVED | REJECTED | ARCHIVED
  status          String   @default("DRAFT")
  title           String
  targetJobId     String?  @map("target_job_id") @db.Uuid
  /// Canonical ResumeDocument (src/modules/resumes/document.ts), validated by Zod
  content         Json
  /// ResumeDocument schema version
  schemaVersion   Int      @default(1) @map("schema_version")
  /// SHA-256 of the canonical normalized content (content identity, not the id)
  contentHash     String   @map("content_hash") @db.Char(64)
  /// Diff metadata vs the parent version (added / removed / changed / reordered)
  changeSummary   Json     @default("{}") @map("change_summary")
  /// Tailoring change set with reasons (TAILORED versions)
  changeSet       Json?    @map("change_set")
  /// True when any content was produced with AI assistance
  aiAssisted      Boolean  @default(false) @map("ai_assisted")
  /// Generation metadata: method, provider, model, options (no private content)
  generation      Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                  User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume                Resume                      @relation("ResumeVersions", fields: [resumeId], references: [id], onDelete: Cascade)
  currentOf             Resume?                     @relation("ResumeCurrentVersion")
  parent                ResumeVersion?              @relation("ResumeVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children              ResumeVersion[]             @relation("ResumeVersionParent")
  targetJob             Job?                        @relation(fields: [targetJobId], references: [id], onDelete: SetNull)
  factReferences        ResumeFactReference[]
  checks                ResumeCheck[]
  approvals             ResumeApproval[]
  exports               ResumeExport[]
  communications        Communication[]
  communicationVersions CommunicationVersion[]
  packageAssets         CommunicationPackageAsset[]

  @@unique([resumeId, versionNumber])
  @@index([userId, createdAt(sort: Desc)])
  @@index([parentVersionId])
  @@index([targetJobId])
  @@map("resume_versions")
}

model ResumeFactReference {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  versionId String   @map("version_id") @db.Uuid
  /// Stable item id inside the ResumeDocument
  itemId    String   @map("item_id")
  /// Candidate fact reference "<kind>:<uuid>" (src/modules/candidate/knowledge.service.ts)
  factRef   String   @map("fact_ref")
  factKind  String   @map("fact_kind")
  factId    String   @map("fact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, itemId, factRef])
  @@index([userId, factId])
  @@map("resume_fact_references")
}

model ResumeCheck {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  /// Content hash that was checked (a check is stale when the version hash differs)
  contentHash    String   @map("content_hash") @db.Char(64)
  /// Job the alignment checks were run against (optional)
  jobId          String?  @map("job_id") @db.Uuid
  checkerVersion String   @map("checker_version")
  /// { passed, issues, warnings, opportunities, byCategory }
  summary        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  version  ResumeVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  job      Job?                 @relation(fields: [jobId], references: [id], onDelete: SetNull)
  findings ResumeCheckFinding[]

  @@index([versionId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([jobId])
  @@map("resume_checks")
}

model ResumeCheckFinding {
  id             String  @id @default(uuid(7)) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  checkId        String  @map("check_id") @db.Uuid
  /// STRUCTURE | CONTENT | ALIGNMENT | READABILITY | FORMATTING | PROVENANCE
  category       String
  /// Stable rule code, e.g. "contact.missing"
  code           String
  /// PASS | INFO | OPPORTUNITY | WARNING | ISSUE
  severity       String
  message        String
  recommendation String?
  /// Item the finding points at (optional)
  itemId         String? @map("item_id")
  evidence       Json    @default("{}")

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  check ResumeCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([userId])
  @@map("resume_check_findings")
}

model ResumeApproval {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  versionId    String    @map("version_id") @db.Uuid
  /// Exact content that was approved
  contentHash  String    @map("content_hash") @db.Char(64)
  approvedAt   DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason String?   @map("revoke_reason")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([userId])
  @@map("resume_approvals")
}

model ResumeExport {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  versionId       String    @map("version_id") @db.Uuid
  /// PDF | DOCX
  format          String
  /// PENDING | SUCCEEDED | FAILED
  status          String    @default("PENDING")
  template        String
  pageFormat      String    @map("page_format")
  /// Resume content hash the file was rendered from
  contentHash     String    @map("content_hash") @db.Char(64)
  /// Whether contentHash equals an active approval of the version at export time
  matchesApproval Boolean   @default(false) @map("matches_approval")
  storagePath     String?   @map("storage_path")
  fileName        String?   @map("file_name")
  byteSize        Int?      @map("byte_size")
  /// SHA-256 of the generated file bytes
  fileSha256      String?   @map("file_sha256") @db.Char(64)
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  version ResumeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("resume_exports")
}

// ---------------------------------------------------------------------------
// AI orchestration (see docs/ai-architecture.md)
//   ai_preferences: USER-OWNED routing/privacy choices. Private candidate data may reach
//   the cloud provider only when allow_private_cloud = true AND the operator switch
//   AI_ALLOW_PRIVATE_GEMINI is on. Default: local only.
// ---------------------------------------------------------------------------

model AiPreferences {
  userId                  String    @id @map("user_id") @db.Uuid
  /// auto | ollama | gemini — preference only; privacy policy always wins
  primaryProvider         String    @default("auto") @map("primary_provider")
  /// Allow Gemini for PUBLIC-only tasks (research synthesis over public sources)
  geminiForPublic         Boolean   @default(true) @map("gemini_for_public")
  /// Explicit opt-in: allow Gemini for PRIVATE candidate data (default OFF)
  allowPrivateCloud       Boolean   @default(false) @map("allow_private_cloud")
  privateCloudConsentedAt DateTime? @map("private_cloud_consented_at") @db.Timestamptz(3)
  /// Try another PERMITTED provider when the first one is unavailable (default OFF)
  autoFallback            Boolean   @default(false) @map("auto_fallback")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_preferences")
}

// ---------------------------------------------------------------------------
// Phase 7 — Email & Cover Letter Studio (see docs/communication-studio.md)
//   Communication assets are PREPARED here, never sent (no delivery exists in Phase 7).
//   communications: user-owned container (EMAIL | COVER_LETTER) bound to a job/company.
//   communication_versions: structured content (Zod), plain text, SHA-256 content hash and
//     the exact generation context (resume version, requirement set = job version, research
//     version, match version). APPROVED content is immutable (DB trigger).
//   communication_claims / _claim_sources: every factual sentence → candidate facts,
//     research claims (company facts) or user-provided context.
//   communication_checks / _findings: deterministic quality results for a content hash.
//   communication_approvals: exact-content approvals; revoked, never deleted.
//   communication_exports: cover-letter PDF/DOCX and email TXT in private storage.
//   signature_presets: reusable signatures; the user chooses which fields appear.
// Closed value sets are CHECK constraints in the migration SQL.
// ---------------------------------------------------------------------------

model Communication {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// EMAIL | COVER_LETTER
  kind                  String
  /// APPLICATION_EMAIL | RECRUITER_OUTREACH | HIRING_MANAGER_OUTREACH | GENERAL_HR_OUTREACH |
  /// NETWORKING_INTRODUCTION | PORTFOLIO_INTRODUCTION | CUSTOM_EMAIL | COVER_LETTER
  communicationType     String    @map("communication_type")
  title                 String
  /// ACTIVE | ARCHIVED
  status                String    @default("ACTIVE")
  jobId                 String?   @map("job_id") @db.Uuid
  companyId             String?   @map("company_id") @db.Uuid
  /// Resume version the communication was written with (never silently rebound)
  resumeVersionId       String?   @map("resume_version_id") @db.Uuid
  /// RECRUITER | HIRING_MANAGER | HR | TEAM_MEMBER | GENERAL_COMPANY | UNKNOWN | CUSTOM
  recipientType         String    @default("UNKNOWN") @map("recipient_type")
  /// Recipient details are only ever what the USER entered — never inferred or discovered
  recipientName         String?   @map("recipient_name")
  recipientTitle        String?   @map("recipient_title")
  recipientCompany      String?   @map("recipient_company")
  recipientEmail        String?   @map("recipient_email")
  /// Where the user got the recipient details (free text, user-provided)
  recipientSource       String?   @map("recipient_source")
  /// USER_PROVIDED | UNVERIFIED
  recipientVerification String    @default("USER_PROVIDED") @map("recipient_verification")
  /// NATURAL | PROFESSIONAL | WARM | DIRECT | CONFIDENT | CONCISE | FORMAL
  tone                  String    @default("NATURAL")
  /// SHORT | STANDARD | DETAILED
  length                String    @default("STANDARD")
  /// Cover letters: CLASSIC | MODERN | MINIMAL | EDITORIAL; emails: structure template key
  template              String    @default("CLASSIC")
  /// A4 | LETTER (cover letters)
  pageFormat            String    @default("A4") @map("page_format")
  signaturePresetId     String?   @map("signature_preset_id") @db.Uuid
  /// Optional context typed by the user (USER_PROVIDED_CONTEXT, never externally verified)
  userContext           String?   @map("user_context")
  /// Reusable recipient this communication is addressed to (inline recipient_* fields mirror it)
  recipientContextId    String?   @map("recipient_context_id") @db.Uuid
  /// Communication strategy: { purpose, requestedAction, primaryEvidence[], secondaryEvidence[] }
  strategy              Json      @default("{}")
  currentVersionId      String?   @unique @map("current_version_id") @db.Uuid
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job              Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company          Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  resumeVersion    ResumeVersion?         @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  signaturePreset  SignaturePreset?       @relation(fields: [signaturePresetId], references: [id], onDelete: SetNull)
  recipientContext RecipientContext?      @relation(fields: [recipientContextId], references: [id], onDelete: SetNull)
  currentVersion   CommunicationVersion?  @relation("CommunicationCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         CommunicationVersion[] @relation("CommunicationVersions")

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([jobId])
  @@index([companyId])
  @@index([resumeVersionId])
  @@index([signaturePresetId])
  @@index([recipientContextId])
  @@map("communications")
}

model CommunicationVersion {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  communicationId  String   @map("communication_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  parentVersionId  String?  @map("parent_version_id") @db.Uuid
  /// GENERATED | AI_ASSISTED | MANUAL_EDIT | RESTORED | DUPLICATED | IMPORTED
  versionType      String   @map("version_type")
  /// AI_GENERATED | AI_ASSISTED | USER_AUTHORED | IMPORTED | RESTORED
  contentSource    String   @map("content_source")
  /// DRAFT | READY_FOR_REVIEW | APPROVED | REJECTED | ARCHIVED
  status           String   @default("DRAFT")
  /// EmailDocument | CoverLetterDocument (src/modules/communications/document.ts), Zod-validated
  content          Json
  schemaVersion    Int      @default(1) @map("schema_version")
  /// Clean plain-text rendering (Phase 8/10 will use this; never HTML)
  plainText        String   @map("plain_text")
  /// SHA-256 of the normalized content (approval identity)
  contentHash      String   @map("content_hash") @db.Char(64)
  /// Exact generation context of THIS version (locked; later versions of these never rebind it)
  resumeVersionId  String?  @map("resume_version_id") @db.Uuid
  /// Job version = the requirement set in effect
  requirementSetId String?  @map("requirement_set_id") @db.Uuid
  /// Research version used
  jobResearchId    String?  @map("job_research_id") @db.Uuid
  /// Match version used
  matchId          String?  @map("match_id") @db.Uuid
  /// SHA-256 of the context (candidate facts, job, resume, research, match, type, tone, length, user context)
  contextHash      String?  @map("context_hash") @db.Char(64)
  /// Generation metadata: method, provider, model, promptVersion, aiGenerationId (no prompts, no secrets)
  generation       Json     @default("{}")
  /// Diff metadata vs the parent version
  changeSummary    Json     @default("{}") @map("change_summary")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  communication  Communication               @relation("CommunicationVersions", fields: [communicationId], references: [id], onDelete: Cascade)
  currentOf      Communication?              @relation("CommunicationCurrentVersion")
  parent         CommunicationVersion?       @relation("CommunicationVersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children       CommunicationVersion[]      @relation("CommunicationVersionParent")
  resumeVersion  ResumeVersion?              @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  requirementSet JobRequirementSet?          @relation(fields: [requirementSetId], references: [id], onDelete: SetNull)
  jobResearch    JobResearch?                @relation(fields: [jobResearchId], references: [id], onDelete: SetNull)
  match          JobMatch?                   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  claims         CommunicationClaim[]
  checks         CommunicationCheck[]
  approvals      CommunicationApproval[]
  exports        CommunicationExport[]
  packageAssets  CommunicationPackageAsset[]

  @@unique([communicationId, versionNumber])
  @@index([userId, createdAt(sort: Desc)])
  @@index([parentVersionId])
  @@index([resumeVersionId])
  @@index([requirementSetId])
  @@index([jobResearchId])
  @@index([matchId])
  @@map("communication_versions")
}

model CommunicationClaim {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  versionId String   @map("version_id") @db.Uuid
  /// Location in the document, e.g. "body:2" or "subject"
  location  String
  text      String
  /// CANDIDATE | COMPANY | USER_CONTEXT
  claimKind String   @map("claim_kind")
  /// SUPPORTED | PARTIALLY_SUPPORTED | UNSUPPORTED | UNKNOWN
  status    String
  reasons   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  version CommunicationVersion       @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sources CommunicationClaimSource[]

  @@index([versionId])
  @@index([userId])
  @@map("communication_claims")
}

model CommunicationClaimSource {
  id              String  @id @default(uuid(7)) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  claimId         String  @map("claim_id") @db.Uuid
  /// CANDIDATE_FACT | RESEARCH_CLAIM | USER_CONTEXT
  sourceKind      String  @map("source_kind")
  /// Candidate fact reference "<kind>:<uuid>" (CANDIDATE_FACT)
  factRef         String? @map("fact_ref")
  /// Research claim (company fact with its own sources) (RESEARCH_CLAIM)
  researchClaimId String? @map("research_claim_id") @db.Uuid

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  claim         CommunicationClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  researchClaim ResearchClaim?     @relation(fields: [researchClaimId], references: [id], onDelete: SetNull)

  @@index([claimId])
  @@index([userId])
  @@index([researchClaimId])
  @@map("communication_claim_sources")
}

model CommunicationCheck {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  versionId      String   @map("version_id") @db.Uuid
  /// Content hash that was checked (stale when the version hash differs)
  contentHash    String   @map("content_hash") @db.Char(64)
  checkerVersion String   @map("checker_version")
  /// { critical, warnings, info, passed, byCategory }
  summary        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  version  CommunicationVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  findings CommunicationCheckFinding[]

  @@index([versionId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("communication_checks")
}

model CommunicationCheckFinding {
  id             String  @id @default(uuid(7)) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  checkId        String  @map("check_id") @db.Uuid
  /// ACCURACY | RELEVANCE | WRITING | COMPLETENESS | LENGTH | CONSISTENCY | PERSONALIZATION
  category       String
  code           String
  /// PASS | INFO | WARNING | CRITICAL
  severity       String
  message        String
  recommendation String?
  location       String?
  evidence       Json    @default("{}")

  user  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  check CommunicationCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@index([checkId])
  @@index([userId])
  @@map("communication_check_findings")
}

model CommunicationApproval {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  versionId       String    @map("version_id") @db.Uuid
  /// Exact content that was approved
  contentHash     String    @map("content_hash") @db.Char(64)
  /// Validation state at approval time (claims + check summary)
  validationState Json      @default("{}") @map("validation_state")
  approvedAt      DateTime  @default(now()) @map("approved_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason    String?   @map("revoke_reason")

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  version CommunicationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([userId])
  @@map("communication_approvals")
}

model CommunicationExport {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  versionId       String    @map("version_id") @db.Uuid
  /// PDF | DOCX | TXT
  format          String
  /// PENDING | SUCCEEDED | FAILED
  status          String    @default("PENDING")
  template        String
  pageFormat      String    @map("page_format")
  contentHash     String    @map("content_hash") @db.Char(64)
  matchesApproval Boolean   @default(false) @map("matches_approval")
  storagePath     String?   @map("storage_path")
  fileName        String?   @map("file_name")
  byteSize        Int?      @map("byte_size")
  fileSha256      String?   @map("file_sha256") @db.Char(64)
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(3)

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  version CommunicationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("communication_exports")
}

model SignaturePreset {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  /// Signature fields chosen by the user: name, email, phone, location, linkedin, portfolio, website
  fields    Json     @default("{}")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  communications Communication[]

  @@index([userId])
  @@map("signature_presets")
}

/// Reusable recipient details the candidate already knows or a legitimate source supplied.
/// Not a discovery engine: nothing here is inferred or generated.
model RecipientContext {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  companyId          String?   @map("company_id") @db.Uuid
  name               String?
  title              String?
  company            String?
  email              String?
  recipientType      String    @default("UNKNOWN") @map("recipient_type")
  /// JOB_POST | OFFICIAL_COMPANY_PAGE | USER_PROVIDED | PUBLIC_PROFESSIONAL_SOURCE | PHASE_8_DISCOVERY | UNKNOWN
  source             String    @default("USER_PROVIDED")
  sourceUrl          String?   @map("source_url")
  /// SOURCE_VERIFIED | UNVERIFIED | INVALID | STALE
  verificationStatus String    @default("UNVERIFIED") @map("verification_status")
  /// HIGH | MEDIUM | LOW
  confidence         String    @default("MEDIUM")
  notes              String?
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyRef            Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  communications        Communication[]
  communicationPackages CommunicationPackage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([companyId])
  @@map("recipient_contexts")
}

/// One row per user: personalization defaults for new communications and AI drafting.
model CommunicationPreference {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  preferredGreeting String?  @map("preferred_greeting")
  preferredClosing  String?  @map("preferred_closing")
  defaultTone       String?  @map("default_tone")
  defaultLength     String?  @map("default_length")
  avoidPhrases      String[] @default([]) @map("avoid_phrases")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("communication_preferences")
}

/// The exact approved assets prepared for one job — the Phase 7 → Phase 8 boundary.
/// READY_FOR_APPLICATION means prepared and approved, NOT submitted.
model CommunicationPackage {
  id                    String    @id @default(uuid(7)) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  jobId                 String    @map("job_id") @db.Uuid
  companyId             String?   @map("company_id") @db.Uuid
  title                 String
  /// EMAIL (resume + email to a recipient) | PORTAL (resume [+ cover letter] [+ email])
  channel               String    @default("PORTAL")
  /// INCOMPLETE | READY_FOR_REVIEW | READY_FOR_APPLICATION | STALE | INVALID | ARCHIVED
  status                String    @default("INCOMPLETE")
  includeCoverLetter    Boolean   @default(false) @map("include_cover_letter")
  includeEmail          Boolean   @default(false) @map("include_email")
  matchId               String?   @map("match_id") @db.Uuid
  requirementSetId      String?   @map("requirement_set_id") @db.Uuid
  jobResearchId         String?   @map("job_research_id") @db.Uuid
  jobContentHash        String?   @map("job_content_hash") @db.Char(64)
  candidateSnapshotHash String?   @map("candidate_snapshot_hash") @db.Char(64)
  recipientContextId    String?   @map("recipient_context_id") @db.Uuid
  recipientSnapshot     Json      @default("{}") @map("recipient_snapshot")
  strategySnapshot      Json      @default("{}") @map("strategy_snapshot")
  integrityHash         String?   @map("integrity_hash") @db.Char(64)
  readyAt               DateTime? @map("ready_at") @db.Timestamptz(3)
  staleAt               DateTime? @map("stale_at") @db.Timestamptz(3)
  staleReasons          Json      @default("[]") @map("stale_reasons")
  invalidReason         String?   @map("invalid_reason")
  archivedAt            DateTime? @map("archived_at") @db.Timestamptz(3)
  previousPackageId     String?   @map("previous_package_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job              Job                         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  company          Company?                    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  match            JobMatch?                   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  requirementSet   JobRequirementSet?          @relation(fields: [requirementSetId], references: [id], onDelete: SetNull)
  jobResearch      JobResearch?                @relation(fields: [jobResearchId], references: [id], onDelete: SetNull)
  recipientContext RecipientContext?           @relation(fields: [recipientContextId], references: [id], onDelete: SetNull)
  previousPackage  CommunicationPackage?       @relation("PackageLineage", fields: [previousPackageId], references: [id], onDelete: SetNull)
  nextPackages     CommunicationPackage[]      @relation("PackageLineage")
  assets           CommunicationPackageAsset[]
  checks           CommunicationPackageCheck[]

  @@index([userId, status, updatedAt(sort: Desc)])
  @@index([jobId])
  @@index([companyId])
  @@index([matchId])
  @@index([requirementSetId])
  @@index([jobResearchId])
  @@index([recipientContextId])
  @@index([previousPackageId])
  @@map("communication_packages")
}

/// Asset manifest: the exact version of each asset in a package (one per asset type).
model CommunicationPackageAsset {
  id                     String   @id @default(uuid(7)) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  packageId              String   @map("package_id") @db.Uuid
  /// RESUME | EMAIL | COVER_LETTER
  assetType              String   @map("asset_type")
  resumeVersionId        String?  @map("resume_version_id") @db.Uuid
  communicationVersionId String?  @map("communication_version_id") @db.Uuid
  /// Content hash of the exact version when it was selected
  contentHash            String   @map("content_hash") @db.Char(64)
  /// Active approval id recorded when the package became ready
  approvalId             String?  @map("approval_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  package              CommunicationPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  resumeVersion        ResumeVersion?        @relation(fields: [resumeVersionId], references: [id], onDelete: Restrict)
  communicationVersion CommunicationVersion? @relation(fields: [communicationVersionId], references: [id], onDelete: Restrict)

  @@unique([packageId, assetType])
  @@index([userId])
  @@index([resumeVersionId])
  @@index([communicationVersionId])
  @@map("communication_package_assets")
}

/// A deterministic readiness check run (checklist items, result, integrity hash at that time).
model CommunicationPackageCheck {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  packageId     String   @map("package_id") @db.Uuid
  /// READY | NOT_READY
  result        String
  items         Json     @default("[]")
  integrityHash String?  @map("integrity_hash") @db.Char(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  package CommunicationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("communication_package_checks")
}
