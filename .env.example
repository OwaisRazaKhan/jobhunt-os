# =============================================================================
# JOBHUNT OS — environment template (Phase 1: Candidate Intelligence)
# Copy to `.env` and fill in. NEVER commit real values. Setup guide: docs/setup.md
#
# Free-first: everything here works with Supabase Free + a local Ollama.
# No paid AI key is required. Only NEXT_PUBLIC_* values reach the browser.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
APP_ENV=development                 # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info                      # debug | info | warn | error

# --- Database: Supabase project "JOBHUNTOS" ---------------------------------------
# Supabase dashboard -> Connect -> ORMs / Prisma.
# Runtime connection (Session pooler, port 5432, or Transaction pooler, port 6543):
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Direct/session connection used by `prisma migrate deploy`:
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Connections per server instance (keep low on Supabase Free; use 1 with `npm run db:local`).
DATABASE_POOL_MAX=5

# --- Authentication: Better Auth -------------------------------------------------
# 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional Google login (openid email profile only — no Gmail access in Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Field-level encryption (phone / professional email at rest) ----------------
# 32 random bytes, base64 (same command as above). Losing it makes those fields unreadable.
ENCRYPTION_KEY=

# --- Supabase Storage (private bucket, server-side only) --------------------------
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Service role key: SERVER ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=candidate-documents
# The anon key is NOT needed: the browser never talks to Supabase directly.
# SUPABASE_ANON_KEY=
MAX_UPLOAD_BYTES=10485760

# --- Local AI: Ollama (optional — the app works fully without it) -----------------
AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_CTX=16384
# Routing: private candidate data always uses Ollama unless BOTH the operator switch below is true
# AND the user opts in on /settings/ai. Public-only tasks (research synthesis) prefer AI_PUBLIC_PROVIDER.
AI_DEFAULT_PROVIDER=ollama
AI_PUBLIC_PROVIDER=gemini
AI_ALLOW_PRIVATE_GEMINI=false
# Google Gemini (optional). API usage/quota/billing is separate from consumer Google subscriptions.
# Server-only secret: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=60000

# --- Scheduled discovery (optional, free) ------------------------------------------
# Secret for POST /api/internal/cron/discovery (Authorization: Bearer <CRON_SECRET>).
# Leave empty to disable the endpoint. Same generator command as above.
CRON_SECRET=
# Due search profiles started per cron call (1-20)
CRON_MAX_PROFILES=5
# Local scheduler loop (`npm run scheduler`): minutes between checks
SCHEDULER_INTERVAL_MINUTES=15

# --- Research (Phase 5) — all optional -------------------------------------------------
# Optional free web discovery: URL of a SearXNG instance you run (JSON format enabled).
# Without it, research still uses the job listing, the company's official site and URLs you add.
SEARXNG_URL=
# Fetch limits (defaults: 30/min, 300/hour per user, 12/min per host, 1.5 MB per page)
RESEARCH_REQUESTS_PER_MINUTE=
RESEARCH_REQUESTS_PER_HOUR=
RESEARCH_PER_HOST_PER_MINUTE=
RESEARCH_MAX_RESPONSE_BYTES=
